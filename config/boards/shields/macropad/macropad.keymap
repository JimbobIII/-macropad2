#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
	combos {
		compatible = "zmk,combos";

		combo_studio_unlock {
			timeout-ms = <50>;
			key-positions = <9 11>;  // bottom-left + bottom-right thumb keys
			bindings = <&studio_unlock>;
		};
	};

	keymap {
		compatible = "zmk,keymap";

		// Layer 0: base — number pad-ish fun layer
		// Bottom-left key held = media layer, bottom-right held = system layer
		default_layer {
			display-name = "Base";
			bindings = <
				&kp N7   &kp N8   &kp N9
				&kp N4   &kp N5   &kp N6
				&kp N1   &kp N2   &kp N3
				&mo 1    &kp N0   &mo 2
			>;
		};

		// Layer 1: media & shortcuts
		media_layer {
			display-name = "Media";
			bindings = <
				&kp C_PREV   &kp C_PP     &kp C_NEXT
				&kp C_VOL_DN &kp C_MUTE   &kp C_VOL_UP
				&kp LC(C)    &kp LC(V)    &kp LC(Z)
				&trans       &kp C_PP     &none
			>;
		};

		// Layer 2: system — Bluetooth profiles, output switching
		system_layer {
			display-name = "System";
			bindings = <
				&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2
				&bt BT_SEL 3  &bt BT_SEL 4  &none
				&out OUT_USB  &out OUT_BLE  &none
				&bt BT_CLR    &none         &trans
			>;
		};
	};
};
